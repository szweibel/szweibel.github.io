---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0))
  .slice(0, 4);
---

<BaseLayout
  title="Stephen Zweibel — Digital Scholarship Librarian"
  description="Stephen Zweibel is an Associate Professor and Digital Scholarship Librarian at the CUNY Graduate Center and co-director of the CUNY AI Lab."
>
  <article class="homepage">
    <header class="intro">
      <h1>Stephen Zweibel</h1>
      <p class="title-line">Associate Professor &amp; Digital Scholarship Librarian<br />CUNY Graduate Center</p>
      <p class="lead">
        I work with students and faculty on digital research, teach programming and computational methods, and build public AI infrastructure as co-director of the <a href="https://ailab.gc.cuny.edu/">CUNY AI Lab</a>.
      </p>
    </header>

    <section class="section">
      <h2>Current work</h2>
      <p>
        At the AI Lab, I build and operate privacy-minded tools for CUNY. I built the CAIL Gateway, which connects the lab’s applications to a curated set of models and handles access, routing, and budgets. I also work on the <a href="https://chat.ailab.gc.cuny.edu/">CAIL Sandbox</a>, agentic studios, and a path for publishing web projects. At the Mina Rees Library, I consult on digital projects, data, preservation, and research workflows.
      </p>
      <p><a href="/about">More about my work</a></p>
    </section>

    {featuredProjects.length > 0 && (
      <section class="section">
        <h2>Selected projects</h2>
        <ul class="project-list">
          {featuredProjects.map((project) => {
            const projectUrl = project.data.url ?? project.data.github;
            return (
              <li class="project-item">
                {projectUrl ? (
                  <a href={projectUrl} target="_blank" rel="noopener noreferrer">{project.data.title}</a>
                ) : (
                  <strong>{project.data.title}</strong>
                )}
                <span class="project-description"> — {project.data.description}</span>
              </li>
            );
          })}
        </ul>
        <p><a href="/projects">View all projects</a></p>
      </section>
    )}

    <section class="section">
      <h2>Contact</h2>
      <p>For questions about AI and digital scholarship, collaboration, or workshops:</p>
      <p><a href="mailto:szweibel@gc.cuny.edu">szweibel@gc.cuny.edu</a></p>
    </section>
  </article>
</BaseLayout>

<style>
  .intro { margin-bottom: 3rem; }
  .intro h1 { margin-bottom: 0.75rem; }
  .title-line { color: var(--color-text-muted); line-height: 1.5; }
  .lead { font-size: 1.1rem; line-height: 1.8; }
  .section { margin-bottom: 2.75rem; padding-left: 1rem; border-left: 3px solid var(--color-border); }
  .section h2 { margin-top: 0; }
  .project-list { list-style: none; padding: 0; }
  .project-item { padding: 0.4rem 0; }
  .project-description { color: var(--color-text-muted); }
</style>
