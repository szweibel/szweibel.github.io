---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const allPublications = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year);

const renderedPublications = await Promise.all(
  allPublications.map(async (publication) => ({
    ...publication,
    Content: (await render(publication)).Content,
  }))
);

const sections = [
  { type: 'peer-reviewed', title: 'Peer-reviewed publications' },
  { type: 'guidelines', title: 'Professional guidelines' },
  { type: 'invited', title: 'Invited publications' },
  { type: 'other', title: 'Essays and other writing' },
].map((section) => ({
  ...section,
  publications: renderedPublications.filter((publication) => publication.data.type === section.type),
}));
---

<BaseLayout
  title="Publications - Stephen Zweibel"
  description="Scholarly publications, professional guidelines, and essays by Stephen Zweibel"
>
  <header class="page-header">
    <h1>Publications</h1>
    <p>Writing on academic libraries, AI, digital scholarship, infrastructure, and research systems.</p>
  </header>

  {sections.map((section) => section.publications.length > 0 && (
    <section class="publication-section">
      <h2>{section.title}</h2>
      <div class="publication-list">
        {section.publications.map((publication) => {
          const { Content } = publication;
          return (
            <article class="publication">
              <h3>
                {publication.data.url ? (
                  <a href={publication.data.url} target="_blank" rel="noopener noreferrer">{publication.data.title}</a>
                ) : publication.data.title}
              </h3>
              <p class="publication-meta">
                {publication.data.authors?.join(', ')}
                {publication.data.journal && <> · <em>{publication.data.journal}</em></>}
                <> · {publication.data.year}</>
              </p>
              <div class="publication-description"><Content /></div>
              {publication.data.url && (
                <a class="publication-link" href={publication.data.url} target="_blank" rel="noopener noreferrer">Read publication →</a>
              )}
            </article>
          );
        })}
      </div>
    </section>
  ))}

  <aside class="additional">
    Conference talks and workshops are listed under <a href="/presentations">presentations</a> and in the <a href="/cv">full CV</a>. Code and teaching materials are available on <a href="https://github.com/szweibel" target="_blank" rel="noopener noreferrer">GitHub</a>.
  </aside>
</BaseLayout>

<style>
  .page-header { margin-bottom: 3rem; }
  .page-header p { color: var(--color-text-muted); }
  .publication-section { margin-top: 3rem; }
  .publication-section > h2 { border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem; }
  .publication-list { display: flex; flex-direction: column; gap: 1rem; }
  .publication { border-left: 3px solid var(--color-border); padding: 1rem 1.25rem; background: var(--color-bg-alt); }
  .publication h3 { font-size: 1.1rem; margin: 0 0 0.5rem; }
  .publication-meta { color: var(--color-text-muted); font-size: 0.85rem; margin-bottom: 0.75rem; }
  .publication-description :global(p) { color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 0.75rem; }
  .publication-link { font-size: 0.85rem; }
  .additional { border: 1px solid var(--color-border); color: var(--color-text-muted); margin-top: 3rem; padding: 1.25rem; }
</style>
