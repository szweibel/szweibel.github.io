---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications'))
  .filter((publication) => publication.data.authors?.includes('Stephen Zweibel'))
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Curriculum Vitae - Stephen Zweibel"
  description="Curriculum vitae for Stephen Zweibel, Associate Professor and Digital Scholarship Librarian at the CUNY Graduate Center"
>
  <article class="cv">
    <header class="cv-header">
      <h1>Curriculum Vitae</h1>
      <div class="contact-block">
        <strong>Stephen Zweibel</strong><br />
        Associate Professor &amp; Digital Scholarship Librarian<br />
        Mina Rees Library, CUNY Graduate Center<br />
        365 Fifth Avenue, New York, NY 10016<br />
        <a href="mailto:szweibel@gc.cuny.edu">szweibel@gc.cuny.edu</a>
      </div>
    </header>

    <section>
      <h2>Professional experience</h2>
      <div class="cv-entry">
        <div>
          <h3>CUNY Graduate Center</h3>
          <p class="role">Associate Professor and Digital Scholarship Librarian</p>
        </div>
        <p class="date">2016–present</p>
      </div>
      <ul>
        <li>Consult with students and faculty on digital research, data, visualization, web publishing, preservation, and computational methods.</li>
        <li>Teach graduate courses and workshops in programming, research computing, and AI-assisted development.</li>
        <li>Serve as liaison for Computational Linguistics, Data Science, Data Visualization, Demography, Digital Humanities, and Geography/GIS.</li>
        <li>Co-direct the <a href="https://ailab.gc.cuny.edu/">CUNY AI Lab</a>; designed and built the CAIL Gateway for shared model access, routing, policy, attribution, and quotas.</li>
      </ul>

      <div class="cv-entry">
        <div>
          <h3>Hunter College</h3>
          <p class="role">Visiting Lecturer</p>
        </div>
        <p class="date">2012–2015</p>
      </div>
      <ul>
        <li>Built a responsive CUNY+ catalog interface and API and developed Augur for reference statistics.</li>
        <li>Automated catalog operations, provided reference service, taught information literacy, and led programming workshops for CUNY librarians.</li>
      </ul>
    </section>

    <section>
      <h2>Education</h2>
      <ul class="plain-list">
        <li><strong>MA, Liberal Studies, Digital Humanities</strong> — CUNY Graduate Center, 2016</li>
        <li><strong>MS, Library and Information Science</strong> — Palmer School, Long Island University, 2010</li>
        <li><strong>Bachelor of Liberal Arts</strong> — St. John’s College, 2008</li>
      </ul>
    </section>

    <section>
      <h2>Grants and awards</h2>
      <ul class="dated-list">
        <li><span>2025</span><div><strong>Principal Investigator</strong>, Provost’s Innovation Grant, “Enhancing Web Accessibility Through Multimodal LLM Analysis” — $10,000</div></li>
        <li><span>2023</span><div><strong>Co-Principal Investigator</strong>, NEH Digital Humanities Advancement Grant for DHRIFT — $300,000</div></li>
        <li><span>2019</span><div><strong>Manager of Open Educational Resources</strong>, NEH Advancement Grant for the Digital Humanities Research Institute — $250,000</div></li>
        <li><span>2017</span><div><strong>Coordinator and workshop leader</strong>, NEH Start-Up Grant for the Digital Humanities Research Institute — $60,000</div></li>
        <li><span>2015</span><div><strong>Co-Principal Investigator</strong>, NEH Start-Up Grant for DH Box — $60,000</div></li>
        <li><span>2014</span><div><strong>Principal Investigator</strong>, ACERT Faculty Innovations in Teaching with Technology Grant — $2,000</div></li>
      </ul>
    </section>

    <section>
      <h2>Publications and guidelines</h2>
      <ul class="dated-list">
        {publications.map((publication) => (
          <li>
            <span>{publication.data.year}</span>
            <div>
              {publication.data.authors?.join(', ')}. {publication.data.url ? (
                <a href={publication.data.url} target="_blank" rel="noopener noreferrer">{publication.data.title}</a>
              ) : publication.data.title}.
              {publication.data.journal && <> <em>{publication.data.journal}</em>.</>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Selected presentations and instruction</h2>
      <ul class="dated-list">
        <li><span>2026</span><div>“Harnessing Agentic AI: Tools for Open University Infrastructure.” In <a href="https://cuny-ai-lab.github.io/ach-2026/">Building Community-Oriented Infrastructures for AI Experimentation</a>, Association for Computers and the Humanities.</div></li>
        <li><span>2026</span><div>“Evaluating AI in Library Discovery.” CUNY library presentation.</div></li>
        <li><span>2025</span><div>“What Happens When ‘Hacking’ Becomes Easy? Teaching Python in 2025.” Digital Humanities 2025, Lisbon. Panelist.</div></li>
        <li><span>2025</span><div>“Introduction to JavaScript.” Digital Humanities Summer Institute, Montreal. Instructor.</div></li>
        <li><span>2024</span><div>“DHRIFT: Digital Humanities Resource Infrastructure for Teaching Technology.” Digital Humanities 2024, Washington, DC. Poster with Lisa Rhody.</div></li>
        <li><span>2024</span><div>“Web APIs with Python.” Digital Humanities Summer Institute, Victoria. Instructor.</div></li>
        <li><span>2019</span><div>“Digital Humanities Research Institute.” Association for Computers and the Humanities, Pittsburgh. Panelist.</div></li>
        <li><span>2018–19</span><div>“Web APIs with Python.” Digital Humanities Summer Institute, Victoria. Instructor.</div></li>
        <li><span>2017</span><div>“DH Box.” Digital Humanities 2017, Montreal. Poster with Jojo Karlin and Patrick Smyth.</div></li>
      </ul>
    </section>

    <section>
      <h2>Teaching</h2>
      <div class="teaching-list">
        <div><h3>AI-Assisted Programming</h3><p>DHUM 78000 / DATA 78000 · Spring and Fall 2026</p></div>
        <div><h3>Python for Researchers</h3><p>CUNY Graduate Center · Fall semesters</p></div>
        <div><h3>Introduction to JavaScript</h3><p>DATA 70600 / DHUM 70600 · Spring semesters</p></div>
        <div><h3>Agentic AI for Library Practice</h3><p>CUNY Office of Library Services · Spring 2026</p></div>
      </div>
    </section>

    <section>
      <h2>Service</h2>
      <ul>
        <li>Chair and primary author, CUNY Libraries Research Artificial Intelligence Task Force, 2024–25</li>
        <li>Author, <em>Evaluating AI Tools in Research Systems</em>, approved by the CUNY Office of Library Services, 2025</li>
        <li>Member, CUNY Graduate Center IT Committee</li>
        <li>Chair, Mina Rees Library Web Services Steering Committee</li>
        <li>Reviewer, National Endowment for the Humanities digital humanities grants, 2016 and 2024</li>
        <li>Reviewer, Graduate Center Provost’s Digital Innovation Grant proposals, 2017 and 2025</li>
      </ul>
    </section>

    <section>
      <h2>Technical areas</h2>
      <p>AI infrastructure and model evaluation; Python, JavaScript, and TypeScript; web applications and APIs; data analysis and visualization; digital preservation; library systems and metadata.</p>
    </section>

    <p class="updated">Last updated: September 2026</p>
  </article>
</BaseLayout>

<style>
  .cv section { margin-top: 3rem; }
  .cv section > h2 { border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem; }
  .contact-block { border: 1px solid var(--color-border); background: var(--color-bg-alt); line-height: 1.8; padding: 1.25rem; }
  .cv-entry { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; margin-top: 1.75rem; }
  .cv-entry h3 { font-size: 1.1rem; margin: 0; }
  .role, .date { color: var(--color-text-muted); font-size: 0.85rem; margin: 0; }
  .date { flex: 0 0 auto; }
  .plain-list { list-style: none; padding: 0; }
  .plain-list li { border-bottom: 1px solid var(--color-border); padding: 0.65rem 0; }
  .dated-list { list-style: none; padding: 0; }
  .dated-list li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.75rem; border-bottom: 1px solid var(--color-border); padding: 0.75rem 0; }
  .dated-list li > span { color: var(--color-text-muted); }
  .teaching-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .teaching-list > div { border: 1px solid var(--color-border); background: var(--color-bg-alt); padding: 1rem; }
  .teaching-list h3 { font-size: 1rem; margin: 0 0 0.5rem; }
  .teaching-list p { color: var(--color-text-muted); font-size: 0.8rem; margin: 0; }
  .updated { border-top: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 0.8rem; margin-top: 3rem; padding-top: 1rem; }
  @media (max-width: 600px) {
    .cv-entry { align-items: flex-start; flex-direction: column; }
    .dated-list li { grid-template-columns: 4.5rem 1fr; }
    .teaching-list { grid-template-columns: 1fr; }
  }
</style>
