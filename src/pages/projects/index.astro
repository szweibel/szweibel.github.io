---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects'))
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0));
---

<BaseLayout
  title="Projects - Stephen Zweibel"
  description="AI infrastructure, digital humanities tools, library applications, and teaching resources"
>
  <header class="page-header">
    <h1>Projects</h1>
    <p>
      AI infrastructure, digital humanities projects, library applications, and open teaching materials. Some are current services; others document earlier experiments and grant-funded work.
    </p>
  </header>

  <div class="projects-list">
    {allProjects.map((project) => {
      const projectUrl = project.data.url ?? project.data.github;
      return (
        <article class="project-card">
          <div class="project-heading">
            <h2>
              {projectUrl ? (
                <a href={projectUrl} target="_blank" rel="noopener noreferrer">{project.data.title}</a>
              ) : project.data.title}
            </h2>
            {project.data.year && <span class="project-year">{project.data.year}</span>}
          </div>

          {(project.data.status || project.data.funding) && (
            <p class="project-meta">{[project.data.status, project.data.funding].filter(Boolean).join(' · ')}</p>
          )}

          <p>{project.data.description}</p>

          {project.data.tags && (
            <ul class="project-tags" aria-label="Project topics">
              {project.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}

          <div class="project-links">
            {project.data.url && <a href={project.data.url} target="_blank" rel="noopener noreferrer">Visit project</a>}
            {project.data.github && <a href={project.data.github} target="_blank" rel="noopener noreferrer">Source code</a>}
          </div>
        </article>
      );
    })}
  </div>

  <aside class="footer-note">
    More workshop materials and experiments are available on <a href="https://github.com/szweibel" target="_blank" rel="noopener noreferrer">GitHub</a>.
  </aside>
</BaseLayout>

<style>
  .page-header { margin-bottom: 2.5rem; }
  .page-header p { color: var(--color-text-muted); }
  .projects-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .project-card { display: flex; flex-direction: column; padding: 1.25rem; border: 1px solid var(--color-border); background: var(--color-bg-alt); }
  .project-heading { display: flex; gap: 1rem; justify-content: space-between; align-items: baseline; }
  .project-heading h2 { font-size: 1.2rem; margin: 0 0 0.5rem; }
  .project-year, .project-meta { color: var(--color-text-muted); font-size: 0.8rem; }
  .project-meta { margin-bottom: 0.75rem; }
  .project-card > p:not(.project-meta) { color: var(--color-text-muted); font-size: 0.9rem; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin-top: auto; padding: 0; }
  .project-tags li { border: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 0.7rem; margin: 0; padding: 0.15rem 0.4rem; }
  .project-links { display: flex; flex-wrap: wrap; gap: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border); font-size: 0.85rem; }
  .footer-note { border-left: 3px solid var(--color-border); color: var(--color-text-muted); margin-top: 2rem; padding: 0.75rem 1rem; }
  @media (max-width: 680px) { .projects-list { grid-template-columns: 1fr; } }
</style>
